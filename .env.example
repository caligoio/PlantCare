# Salin file ini menjadi .env (jangan di-commit), lalu ubah nilainya.
# Jika .env tidak ada, docker-compose memakai nilai bawaan di docker-compose.yml.
DB_USER=plantcare
DB_PASSWORD=ganti_dengan_sandi_kuat
DB_NAME=plantcare

# Rahasia untuk menandatangani token login (minimal 16 karakter, makin acak makin baik).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=isi_dengan_rahasia_acak_minimal_16_karakter
# Ubah ke true hanya jika aplikasi diakses lewat HTTPS
COOKIE_SECURE=false
